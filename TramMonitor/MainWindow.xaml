<Window x:Class="TramMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TramMonitor.ViewModels"
        xmlns:views="clr-namespace:TramMonitor.Views"
        Title="TramMonitor — Череповец"
        Height="820"
        Width="1300"
        MinHeight="600"
        MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#EAF0FC">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrackingViewModel}">
            <views:TrackingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RoutesViewModel}">
            <views:RoutesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>

        <Style x:Key="NavigationButtonStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#24344F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#EDF2FC"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#2878E5"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#F8FAFF"
                BorderBrush="#DCE5F4"
                BorderThickness="0,0,0,1">

            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="▣  TramMonitor"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#172B50"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Width="1"
                        Height="25"
                        Background="#BFCADD"
                        Margin="18,0"/>

                <TextBlock Grid.Column="2"
                           Text="Череповец"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#24344F"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse Width="9"
                             Height="9"
                             Fill="#35C759"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="Модель активна"
                               Foreground="#526174"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая навигация -->
            <Border Grid.Column="0"
                    Background="#F8FAFF"
                    BorderBrush="#DCE5F4"
                    BorderThickness="0,0,1,0">

                <ListBox Margin="10,15,10,10"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavigationButtonStyle}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NavigationIcon"
                                           Grid.Column="0"
                                           Text="●"
                                           FontSize="15"
                                           Foreground="#718096"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="17"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Title}" Value="Моделирование">
                                    <Setter TargetName="NavigationIcon"
                                            Property="Text" Value="▶"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Title}" Value="Отслеживание">
                                    <Setter TargetName="NavigationIcon"
                                            Property="Text" Value="◎"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Title}" Value="Аналитика">
                                    <Setter TargetName="NavigationIcon"
                                            Property="Text" Value="▥"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Title}" Value="Расписания и маршруты">
                                    <Setter TargetName="NavigationIcon"
                                            Property="Text" Value="▦"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Title}" Value="Маршруты">
                                    <Setter TargetName="NavigationIcon"
                                            Property="Text" Value="▦"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Рабочая область -->
            <Border Grid.Column="1"
                    Padding="10"
                    Background="#EAF0FC">

                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
