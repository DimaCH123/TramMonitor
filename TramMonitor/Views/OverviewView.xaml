<UserControl x:Class="TramMonitor.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Обзор системы"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#243447"
                       Margin="0,0,0,25"/>
            <UniformGrid Columns="2" Margin="0,0,0,30">
                <Border Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Количество маршрутов"
                                   Foreground="#7B8794"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding RouteCount}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#243447"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="10,0,0,0">

                    <StackPanel>
                        <TextBlock Text="Трамваев на линии"
                                   Foreground="#7B8794"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding TotalTrams}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#243447"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>
            </UniformGrid>
            <TextBlock Text="Маршруты"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#243447"
                       Margin="0,0,0,15"/>
            <DataGrid ItemsSource="{Binding Routes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="45"
                      ColumnHeaderHeight="40">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Маршрут"
                                        Binding="{Binding RouteNumber}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Трамваев"
                                        Binding="{Binding TramCount}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Интервал (мин)"
                                        Binding="{Binding IntervalMinutes}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>