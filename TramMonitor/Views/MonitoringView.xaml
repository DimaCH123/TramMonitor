<UserControl x:Class="TramMonitor.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900">

    <UserControl.Resources>
        
        <!-- Цвета -->
        <SolidColorBrush x:Key="MainText" Color="#172B50"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#718096"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2878E5"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E8F2"/>

        <!-- Общие панели -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172B50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#C5CBD4"
                                                CornerRadius="4"
                                                Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ParameterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#526174"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ParameterValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172B50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Единый стиль ползунков -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#2878E5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False"
                                                  IsTabStop="False"
                                                  BorderThickness="0"
                                                  Height="4"
                                                  Background="#2878E5"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Fill="#2878E5"
                                                         Stroke="White"
                                                         StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False"
                                                  IsTabStop="False"
                                                  BorderThickness="0"
                                                  Height="4"
                                                  Background="#DCE5F4"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Круглые кнопки управления -->
        <Style x:Key="RoundControlButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обычные компактные кнопки -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточки статистики -->
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Таблица -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F6F8FC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5FB"/>
            <Setter Property="Foreground" Value="#526174"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E1E8F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Foreground" Value="#34445A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F0FF"/>
                    <Setter Property="Foreground" Value="#172B50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#34445A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF4FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F0FF"/>
                    <Setter Property="Foreground" Value="#172B50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Цвета маркеров событий -->
        <Style x:Key="EventMarkerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#8A94A6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="1,5,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Event}" Value="Начало движения">
                    <Setter Property="Fill" Value="#00914B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Возвращение к работе">
                    <Setter Property="Fill" Value="#00914B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Прибытие на остановку">
                    <Setter Property="Fill" Value="#2878E5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Ожидание свободной остановки">
                    <Setter Property="Fill" Value="#E69A27"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Начало обеда">
                    <Setter Property="Fill" Value="#8053B5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Окончание обеда">
                    <Setter Property="Fill" Value="#8053B5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Начало пересменки">
                    <Setter Property="Fill" Value="#159E9A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Окончание пересменки">
                    <Setter Property="Fill" Value="#159E9A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Event}" Value="Завершение смены">
                    <Setter Property="Fill" Value="#8A94A6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EAF0FC" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="215"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelStyle}"
                Padding="9,6"
                Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="▶"
                        Command="{Binding StartSimulationCommand}"
                        Style="{StaticResource RoundControlButton}"
                        Background="#2878E5"
                        Foreground="White"
                        ToolTip="Запустить"/>

                <Button Grid.Column="1"
                        Content="Ⅱ"
                        Command="{Binding PauseSimulationCommand}"
                        Style="{StaticResource RoundControlButton}"
                        Background="#EAF1FC"
                        Foreground="#243F70"
                        Margin="7,0,0,0"
                        ToolTip="Пауза"/>

                <Button Grid.Column="2"
                        Content="↻"
                        Command="{Binding RestartSimulationCommand}"
                        Style="{StaticResource RoundControlButton}"
                        Background="#EAF1FC"
                        Foreground="#243F70"
                        Margin="7,0,12,0"
                        ToolTip="Перезапуск"/>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="ВРЕМЯ МОДЕЛИ"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#718096"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentTimeText}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172B50"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Text="Перейти:"
                           FontSize="11"
                           Foreground="#718096"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"/>

                <TextBox Grid.Column="5"
                         Text="{Binding SelectedTimeText, UpdateSourceTrigger=PropertyChanged}"
                         Width="78"
                         Height="31"
                         MaxLength="8"
                         Padding="6,3"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         BorderBrush="#DCE5F4"
                         ToolTip="Формат ЧЧ:ММ:СС"/>

                <Button Grid.Column="6"
                        Content="Перемотать"
                        Command="{Binding SeekTimeCommand}"
                        Style="{StaticResource SmallActionButton}"
                        Background="#EAF2FC"
                        Foreground="#2878E5"
                        Margin="6,0,0,0"/>

                <Border Grid.Column="7"
                        Background="#EAF2FC"
                        CornerRadius="6"
                        Padding="9,6"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#2878E5"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="МОДЕЛИРОВАНИЕ"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#2878E5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Центральная область -->
        <Grid Grid.Row="1" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Схема маршрутов -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Padding="7"
                    Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Схема движения"
                                   Style="{StaticResource PanelTitle}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#00914B"/>
                            <TextBlock Text="4"
                                       FontSize="10"
                                       Foreground="#526174"
                                       Margin="3,0,9,0"/>
                            <Ellipse Width="7" Height="7" Fill="#DC232D"/>
                            <TextBlock Text="8"
                                       FontSize="10"
                                       Foreground="#526174"
                                       Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="MapScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                        <Canvas x:Name="MapCanvas"
                                Width="1000"
                                Height="2500"
                                Background="#FFFFFF"
                                RenderTransformOrigin="0,0">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="MapScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1"/>
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Таблица трамваев -->
            <Border Grid.Column="1"
                    Style="{StaticResource PanelStyle}"
                    Padding="9"
                    Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,1,2,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Все трамваи"
                                       Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="{Binding TotalTramsCount, StringFormat= ({0})}"
                                       Foreground="#718096"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="СОСТОЯНИЕ ПАРКА"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="#9AA6B7"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="TramGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Simulation.Trams}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              FontSize="10"
                              RowHeight="30"
                              ColumnHeaderHeight="32"
                              BorderThickness="0"
                              Background="White"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              AlternationCount="2">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="34"/>

                            <DataGridTemplateColumn Header="Марш." Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="5,2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EDF1F7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RouteNumber}" Value="4">
                                                            <Setter Property="Background" Value="#E3F3E9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RouteNumber}" Value="8">
                                                            <Setter Property="Background" Value="#FBE8E9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RouteNumber}" Value="2">
                                                            <Setter Property="Background" Value="#EEEAF8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RouteNumber}" Value="4a">
                                                            <Setter Property="Background" Value="#F5EDE8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding RouteNumber}"
                                                       FontSize="10"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#526174"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RouteNumber}" Value="4">
                                                                <Setter Property="Foreground" Value="#008342"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RouteNumber}" Value="8">
                                                                <Setter Property="Foreground" Value="#C9232D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RouteNumber}" Value="2">
                                                                <Setter Property="Foreground" Value="#3A3089"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RouteNumber}" Value="4a">
                                                                <Setter Property="Foreground" Value="#A6634D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Вагон"
                                                Binding="{Binding NumberOnRoute}"
                                                Width="43"/>

                            <DataGridTextColumn Header="Смена"
                                                Binding="{Binding ShiftText}"
                                                Width="48"/>

                            <DataGridTextColumn Header="Круги"
                                                Binding="{Binding CirclesDone}"
                                                Width="42"/>

                            <DataGridTextColumn Header="Остановка"
                                                Binding="{Binding CurrentStop.Name}"
                                                Width="*"
                                                MinWidth="70"/>

                            <DataGridTextColumn Header="Состояние"
                                                Binding="{Binding StatusText}"
                                                Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- Статистика парка -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Padding="9"
                    Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Состояние парка"
                               Style="{StaticResource PanelTitle}"
                               Margin="3,1,0,5"/>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Border Style="{StaticResource StatusCard}" Background="#E8F4EC">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="На линии" FontSize="10" Foreground="#527A60" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnLineCount}" FontSize="23" FontWeight="Bold" Foreground="#267344" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnLineBreakdown}" FontSize="9" Foreground="#527A60" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCard}" Background="#FFF3DF">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="На обеде" FontSize="10" Foreground="#A17B3D" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnLunchCount}" FontSize="23" FontWeight="Bold" Foreground="#94600C" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnLunchBreakdown}" FontSize="9" Foreground="#A17B3D" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCard}" Background="#F0EAF8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Пересменка" FontSize="10" Foreground="#8068A2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnShiftChangeCount}" FontSize="23" FontWeight="Bold" Foreground="#69449A" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TramsOnShiftChangeBreakdown}" FontSize="9" Foreground="#8068A2" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCard}" Background="#EAF2FC">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Всего" FontSize="10" Foreground="#526174" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalTramsCount}" FontSize="23" FontWeight="Bold" Foreground="#243F70" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalTramsBreakdown}" FontSize="9" Foreground="#526174" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Параметры модели -->
            <Border Grid.Column="1"
                    Style="{StaticResource PanelStyle}"
                    Padding="10"
                    Margin="5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Параметры модели"
                               Style="{StaticResource PanelTitle}"
                               Margin="2,1,0,7"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <Grid Grid.Column="0" Margin="2,0,9,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0"
                                      ItemsSource="{Binding RouteDataService.Routes}"
                                      SelectedItem="{Binding SelectedRouteForSettings}"
                                      DisplayMemberPath="RouteNumber"
                                      Height="25"
                                      FontSize="11"
                                      Margin="0,0,0,4"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Трамваев" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteTramCount}" Minimum="0" Maximum="20" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteTramCount}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Интервал, мин" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteInterval}" Minimum="3" Maximum="30" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteInterval}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Обед, мин" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteLunchTime}" Minimum="5" Maximum="60" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteLunchTime}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Перегон, мин" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteTravelTime}" Minimum="1" Maximum="10" TickFrequency="0.5"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteTravelTime, StringFormat=F1}" Style="{StaticResource ParameterValue}"/>
                            </Grid>
                        </Grid>

                        <!-- Правая колонка -->
                        <Grid Grid.Column="1" Margin="9,0,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Стоянка, сек" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteStopDuration}" Minimum="5" Maximum="120" TickFrequency="5"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteStopDuration}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Кругов до обеда" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteCirclesBeforeLunch}" Minimum="1" Maximum="10" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteCirclesBeforeLunch}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Кругов после обеда" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteCirclesAfterLunch}" Minimum="1" Maximum="10" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteCirclesAfterLunch}" Style="{StaticResource ParameterValue}"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Пересменка, мин" Style="{StaticResource ParameterLabel}"/>
                                <Slider Grid.Column="1" Value="{Binding SelectedRouteShiftChange}" Minimum="5" Maximum="60" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedRouteShiftChange}" Style="{StaticResource ParameterValue}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Последние события -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}"
                    Padding="9"
                    Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,1,2,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Последние события"
                                   Style="{StaticResource PanelTitle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="ЖУРНАЛ"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="#9AA6B7"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EDF1F7"
                                            BorderThickness="0,0,0,1"
                                            Padding="3,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="11"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Style="{StaticResource EventMarkerStyle}"/>

                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Event}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#34445A"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Time, StringFormat={}{0:hh\\:mm\\:ss}}"
                                                               FontSize="9"
                                                               Foreground="#8A94A6"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Top"/>
                                                </Grid>

                                                <TextBlock FontSize="9"
                                                           Foreground="#718096"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0">
                                                    <Run Text="Маршрут "/>
                                                    <Run Text="{Binding RouteNumber}"/>
                                                    <Run Text=" · вагон №"/>
                                                    <Run Text="{Binding NumberOnRoute}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CurrentStop}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
