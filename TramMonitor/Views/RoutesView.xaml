<UserControl x:Class="TramMonitor.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <TextBlock Text="Расписания и маршруты"
                FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#243447"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Выберите маршрут"
                       FontSize="14"
                       Foreground="#7B8794"
                       Margin="0,0,0,8"/>

            <ComboBox ItemsSource="{Binding Routes}"
                      SelectedItem="{Binding SelectedRoute}"
                      DisplayMemberPath="RouteNumber"
                      Width="180"
                      Height="38"
                      HorizontalAlignment="Left"/>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,20,0,20">

                <StackPanel>

                    <TextBlock Text="{Binding SelectedRoute.RouteNumber,
                                              StringFormat=Маршрут № {0}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#243447"
                               Margin="0,0,0,15"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Тип движения"
               Foreground="#7B8794"
               FontSize="13"/>

                            <TextBlock
        Text="{Binding SelectedRoute.MovementType}"
        FontSize="16"
        FontWeight="SemiBold"
        Foreground="#243447"
        Margin="0,4,0,12"/>

                            <TextBlock Text="Участие в симуляции"
               Foreground="#7B8794"
               FontSize="13"/>

                            <TextBlock
        Text="{Binding SelectedRoute.IsEnabledInSimulation,
                       StringFormat={}{0:Да;Нет}}"
        FontSize="16"
        FontWeight="SemiBold"
        Foreground="#243447"
        Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <StackPanel>
                            <TextBlock Text="Трамваев"
                                       Foreground="#7B8794"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding SelectedRoute.TramCount}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#243447"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Интервал движения"
                                       Foreground="#7B8794"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding SelectedRoute.IntervalMinutes,
                                                      StringFormat={}{0} мин.}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#243447"/>
                        </StackPanel>

                    </UniformGrid>

                </StackPanel>

            </Border>

            <TextBlock Text="Последовательность остановок"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#243447"
                       Margin="0,0,0,15"/>

            <DataGrid ItemsSource="{Binding SelectedRoute.Stops}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="42"
                      ColumnHeaderHeight="40">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="№"
                                        Binding="{Binding Order}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Название остановки"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

            

        </StackPanel>

    </ScrollViewer>

</UserControl>